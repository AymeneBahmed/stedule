generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          Int      @id @default(autoincrement())
  name        String
  day         Int
  time        Time     @relation(fields: [timeId], references: [id], onDelete: Cascade)
  priority    Priority
  description String?
  timeId      Int
}

model Time {
  id     Int @id @default(autoincrement())
  hour   Int
  minute Int

  Task Task[]
}

enum Priority {
  Unspecified
  Low
  Medium
  High
}
