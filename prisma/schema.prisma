generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id          Int      @id @default(autoincrement())
  name        String
  day         Int
  priority    Priority
  description String?
}

enum Priority {
  Unspecified
  Low
  Medium
  High
}
